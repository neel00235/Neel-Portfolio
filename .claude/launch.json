{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "portfolio",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "5173", "."],
      "port": 5173
    },
    {
      "name": "portfolio-prod",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5180", "--directory", "out"],
      "port": 5180
    }
  ]
}
